{
  "name": "sector-tagger-svelte",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run dev:all",
    "dev:all": "concurrently \"bun run dev:frontend\" \"bun run dev:ws\"",
    "dev:frontend": "astro dev",
    "dev:ws": "bun run scripts/ws-server.ts",
    "start": "concurrently \"HOST=0.0.0.0 node ./dist/server/entry.mjs\" \"WS_HOST=0.0.0.0 bun run scripts/ws-server.ts\"",
    "build": "astro check && astro build",
    "preview": "bun run preview:all",
    "preview:all": "concurrently \"astro preview\" \"bun run dev:ws\"",
    "db:init": "bun run scripts/init-db.ts",
    "db:migrate": "bun run scripts/migrate.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/svelte": "^7.0.4",
    "astro": "^5.1.9",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "svelte": "^5.19.3",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@astrojs/node": "^9.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "bun-types": "^1.2.0",
    "concurrently": "^9.1.2",
    "svelte-check": "^4.1.4"
  }
}
