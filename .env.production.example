# Production environment variables
# Copy this file to .env.production and adjust values

# Server port
PORT=8080

# HMR settings (Hot Module Replacement)
VITE_HMR_PROTOCOL=wss
VITE_HMR_HOST=your-domain.com
VITE_HMR_PORT=443
VITE_HMR_CLIENT_PORT=443
VITE_HMR_PATH=/ws

# WebSocket settings
VITE_WS_PROXY_TARGET=wss://your-domain.com
VITE_WS_SECURE=true

# File watching (set to true if needed in container)
VITE_USE_POLLING=true
